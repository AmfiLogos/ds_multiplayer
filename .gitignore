# Only source, scripts and notes go in git. Never game files, dumps, builds, saves or test output.
/*
!/.gitignore
!/PLAN.md
!/LANE_RULES.md
!/README.md
!/ROADMAP.md
!/LICENSE
!/src/
!/custom/
!/sdk/
!/win/
!/rig/
!/ext/
!/research/
/research/*
!/research/*.md
# game binaries and dumps (copyright: never publish)
*.dll
*.dylib
*.exe
*.dat
*.so
*.o
*.a
dump/
dump.cs
il2cpp.h
script.json
methods.tsv
/win/25846389/
/win/mac_unityplayer/
/win/probe/
/win/kit/
# builds, copies, test output
build/
build_*/
old/
old_versions/
out/
det_out/
instances/
*.noindex/
/rig/lan*/
/rig/release/
/rig/smoke_out/
/rig/tools/
*.zip
*.png
*.jpg
*.log
*.out
*.orig
*.pyc
__pycache__/
*.lock
leases.json
.DS_Store
backups/
saves/
*AutoSave*
*_Save*.json
# lane copies of src (git branches replace them)
/ext/*/merge/
/ext/*/base/
/ext/*/work/
/ext/*/lane_*/
/ext/*/src/
/ext/*/src_base/
fixtures/
/win/tools/il2cppdumper_nokey/
# own test binaries
*_bin
*.dSYM/
src/ui_test/test_ui
src/ui_test/teams_test
