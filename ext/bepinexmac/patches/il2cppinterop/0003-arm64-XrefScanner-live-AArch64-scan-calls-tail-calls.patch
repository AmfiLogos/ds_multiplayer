+    /// <summary>arm64: native code pointer -> generated method (set by Il2CppInterop.Runtime).</summary>
+    public static Func<IntPtr, MethodBase?>? NativePointerResolver;
+
     public static MethodBase TryResolvePointer(IntPtr methodStart)
     {
+        // The map holds x86-64 slice addresses; arm64 resolves through the live il2cpp method table.
+        if (Arm64Code.IsArm64 && NativePointerResolver != null)
+            return NativePointerResolver(methodStart)!;
         return MethodMap.Lookup((long)methodStart - GameAssemblyBase);
     }
 
+    internal static IEnumerable<XrefInstance> ListUsersArm64(CachedScanResultsAttribute attribute)
+    {
+        for (var i = attribute.RefRangeStart; i < attribute.RefRangeEnd; i++)
+        {
+            var x86 = XrefScanCache.GetAt(i);
+            var method = MethodMap.Lookup(x86.Address);
+            var field = method == null ? null : Il2CppInteropUtils.GetIl2CppMethodInfoPointerFieldForGeneratedMethod(method);
+            var methodInfo = field?.GetValue(null);
+            if (methodInfo == null || (IntPtr)methodInfo == IntPtr.Zero) continue;
+            var code = Marshal.ReadIntPtr((IntPtr)methodInfo);
+            yield return new XrefInstance(XrefType.Method, code, code);
+        }
+    }
+
     internal static IEnumerable<XrefInstance> ListUsers(CachedScanResultsAttribute attribute)
     {
         for (var i = attribute.RefRangeStart; i < attribute.RefRangeEnd; i++)
