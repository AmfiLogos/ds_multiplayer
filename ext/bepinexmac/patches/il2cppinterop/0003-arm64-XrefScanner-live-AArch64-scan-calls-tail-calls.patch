diff --git a/Il2CppInterop.Common/XrefScans/Arm64Code.cs b/Il2CppInterop.Common/XrefScans/Arm64Code.cs
index 455030c..524594f 100644
--- a/Il2CppInterop.Common/XrefScans/Arm64Code.cs
+++ b/Il2CppInterop.Common/XrefScans/Arm64Code.cs
@@ -116,6 +116,152 @@ public static class Arm64Code
         return (IntPtr)found;
     }
 
+    /// <summary>
+    ///     arm64 counterpart of XrefScanner.XrefScanImpl: calls (BL), tail calls (B to a function start) and
+    ///     64-bit loads from ADRP pages (the "mov reg, [rip+x]" globals, filtered like on x86), up to the first RET.
+    ///     Runs the method's lazy runtime-metadata initialisation first so string literal slots are filled.
+    /// </summary>
+    public static IEnumerable<XrefInstance> XrefScan(IntPtr start)
+    {
+        InitRuntimeMetadata(start);
+        var starts = StartsFor(start);
+        var stop = NextStart(starts, (long)start);
+        var value = new long[32]; // known addresses per register (ADRP / ADD / MOV)
+        var result = new List<XrefInstance>();
+        for (var at = (long)start; at < stop; at += 4)
+        {
+            var insn = (uint)Marshal.ReadInt32((IntPtr)at);
+            if ((insn & 0xFFFFFC1Fu) == 0xD65F0000u)
+                break;
+            if ((insn & 0xFC000000u) == 0x94000000u)
+            {
+                result.Add(new XrefInstance(XrefType.Method, (IntPtr)BranchTarget(at, insn), (IntPtr)at));
+                Array.Clear(value, 0, 19); // x0-x18 do not survive a call
+                continue;
+            }
+            if ((insn & 0xFC000000u) == 0x14000000u)
+            {
+                var target = BranchTarget(at, insn);
+                if (target != (long)start && IsStart(starts, target))
+                    result.Add(new XrefInstance(XrefType.Method, (IntPtr)target, (IntPtr)at));
+                continue;
+            }
+            if ((insn & 0x9F000000u) == 0x90000000u) // ADRP
+            {
+                value[insn & 0x1F] = AdrpTarget(at, insn);
+                continue;
+            }
+            if ((insn & 0xFFC00000u) == 0x91000000u) // ADD Xd, Xn, #imm12
+            {
+                var rn = (insn >> 5) & 0x1F;
+                value[insn & 0x1F] = value[rn] != 0 ? value[rn] + ((insn >> 10) & 0xFFF) : 0;
+                continue;
+            }
+            if ((insn & 0xFFE0FFE0u) == 0xAA0003E0u) // MOV Xd, Xm
+            {
+                value[insn & 0x1F] = value[(insn >> 16) & 0x1F];
+                continue;
+            }
+            if ((insn & 0xFFC00000u) == 0xF9400000u) // LDR Xt, [Xn, #imm12*8]
+            {
+                var rn = (insn >> 5) & 0x1F;
+                if (value[rn] != 0)
+                {
+                    var target = (IntPtr)(value[rn] + ((insn >> 10) & 0xFFF) * 8);
+                    try
+                    {
+                        if (XrefScannerManager.Impl.XrefGlobalClassFilter(target))
+                            result.Add(new XrefInstance(XrefType.Global, target, (IntPtr)at));
+                    }
+                    catch (Exception)
+                    {
+                        // unreadable target: not a global
+                    }
+                }
+                value[insn & 0x1F] = 0;
+                continue;
+            }
+            // Stores and compares keep their registers; anything else with Rd in bits 0-4 forgets it.
+            if ((insn & 0x0A000000u) != 0x08000000u || (insn & 0x00400000u) != 0)
+                value[insn & 0x1F] = 0;
+        }
+
+        return result;
+    }
+
+    private static long s_InitFunction = -1;
+
+    /// <summary>
+    ///     Unity 6 IL2CPP methods start with "ldrb wN, [flag]; tbnz", then "x0 = &amp;slot; bl InitializeRuntimeMetadata"
+    ///     per metadata slot, then set the flag. Call the init function (the first call of UnityEngine.Object's
+    ///     static constructor, as on x86) for each slot; it is idempotent in libil2cpp. The flag is left alone.
+    /// </summary>
+    private static void InitRuntimeMetadata(IntPtr start)
+    {
+        if (s_InitFunction == -1)
+        {
+            var resolver = XrefScannerManager.Impl.GetMetadataResolver();
+            s_InitFunction = resolver is ({ } _, var pointer) ? (long)pointer : 0;
+        }
+
+        if (s_InitFunction == 0)
+            return;
+
+        var stop = Math.Min(NextStart(StartsFor(start), (long)start), (long)start + 4096);
+        var value = new long[32];
+        for (var at = (long)start; at < stop; at += 4)
+        {
+            var insn = (uint)Marshal.ReadInt32((IntPtr)at);
+            if ((insn & 0xFFFFFC1Fu) == 0xD65F0000u)
+                break;
+            if ((insn & 0x9F000000u) == 0x90000000u) // ADRP
+            {
+                value[insn & 0x1F] = AdrpTarget(at, insn);
+                continue;
+            }
+            if ((insn & 0xFFC00000u) == 0x91000000u) // ADD Xd, Xn, #imm12
+            {
+                var rn = (insn >> 5) & 0x1F;
+                value[insn & 0x1F] = value[rn] != 0 ? value[rn] + ((insn >> 10) & 0xFFF) : 0;
+                continue;
+            }
+            if ((insn & 0xFFE0FFE0u) == 0xAA0003E0u) // MOV Xd, Xm
+            {
+                value[insn & 0x1F] = value[(insn >> 16) & 0x1F];
+                continue;
+            }
+            if ((insn & 0xFC000000u) == 0x94000000u) // BL
+            {
+                if (BranchTarget(at, insn) != s_InitFunction)
+                    break; // past the metadata block
+                if (value[0] != 0)
+                    InitSlot(s_InitFunction, value[0]);
+                continue;
+            }
+            if ((insn & 0xFC000000u) == 0x14000000u)
+                break;
+            if ((insn & 0x1F) != 31)
+                value[insn & 0x1F] = 0; // anything else writing a register
+        }
+    }
+
+    private static void InitSlot(long init, long slot)
+    {
+        var fn = (InitMetadataSlot)Marshal.GetDelegateForFunctionPointer((IntPtr)init, typeof(InitMetadataSlot));
+        fn((IntPtr)slot);
+    }
+
+    [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+    private delegate void InitMetadataSlot(IntPtr slot);
+
+    private static long AdrpTarget(long at, uint insn)
+    {
+        var immlo = (insn >> 29) & 0x3;
+        var immhi = (insn >> 5) & 0x7FFFF;
+        var imm = (long)(((int)((immhi << 2 | immlo) << 11)) >> 11); // sign-extend 21 bits
+        return (at & ~0xFFFL) + (imm << 12);
+    }
+
     private static long BranchTarget(long at, uint insn)
     {
         var imm26 = (int)(insn << 6) >> 6;
