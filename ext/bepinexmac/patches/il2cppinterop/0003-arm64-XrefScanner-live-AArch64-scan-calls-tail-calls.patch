diff --git a/Il2CppInterop.Runtime/XrefScans/Arm64MethodResolver.cs b/Il2CppInterop.Runtime/XrefScans/Arm64MethodResolver.cs
new file mode 100644
index 0000000..4cad61f
--- /dev/null
+++ b/Il2CppInterop.Runtime/XrefScans/Arm64MethodResolver.cs
@@ -0,0 +1,129 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Common;
+using Il2CppInterop.Common.XrefScans;
+using Il2CppInterop.Runtime.Runtime;
+
+namespace Il2CppInterop.Runtime.XrefScans;
+
+/// <summary>
+///     arm64: the generated MethodAddressToToken map holds x86-64 slice addresses. Resolve an arm64 code pointer
+///     through the live il2cpp method table instead: pointer -> MethodInfo* -> declaring class -> generated type
+///     -> the generated method whose method-info field holds that MethodInfo*.
+/// </summary>
+internal static unsafe class Arm64MethodResolver
+{
+    private static Dictionary<IntPtr, List<IntPtr>>? s_MethodInfoByCode;
+    private static readonly Dictionary<IntPtr, MethodBase?> s_Resolved = new();
+
+    public static MethodBase? Resolve(IntPtr code)
+    {
+        lock (s_Resolved)
+        {
+            if (s_Resolved.TryGetValue(code, out var known))
+                return known;
+            s_MethodInfoByCode ??= BuildTable();
+            MethodBase? result = null;
+            if (s_MethodInfoByCode.TryGetValue(code, out var methodInfos))
+                foreach (var methodInfo in methodInfos) // folded bodies: several methods share one pointer
+                    if ((result = FromMethodInfo(methodInfo)) != null)
+                        break;
+            s_Resolved[code] = result;
+            return result;
+        }
+    }
+
+    private static Dictionary<IntPtr, List<IntPtr>> BuildTable()
+    {
+        var table = new Dictionary<IntPtr, List<IntPtr>>();
+        int total = 0, zero = 0;
+        uint count = 0;
+        var assemblies = IL2CPP.il2cpp_domain_get_assemblies(IL2CPP.il2cpp_domain_get(), ref count);
+        for (var a = 0; a < count; a++)
+        {
+            var image = IL2CPP.il2cpp_assembly_get_image(assemblies[a]);
+            var classes = IL2CPP.il2cpp_image_get_class_count(image);
+            for (uint c = 0; c < classes; c++)
+            {
+                var klass = IL2CPP.il2cpp_image_get_class(image, c);
+                var iter = IntPtr.Zero;
+                IntPtr method;
+                while ((method = IL2CPP.il2cpp_class_get_methods(klass, ref iter)) != IntPtr.Zero)
+                {
+                    var code = UnityVersionHandler.Wrap((Il2CppMethodInfo*)method).MethodPointer;
+                    total++;
+                    if (code == IntPtr.Zero) { zero++; continue; }
+                    if (!table.TryGetValue(code, out var list))
+                        table[code] = list = new List<IntPtr>();
+                    list.Add(method);
+                }
+            }
+        }
+
+        Microsoft.Extensions.Logging.LoggerExtensions.LogInformation(Logger.Instance,
+            "arm64 xref resolver: {Total} methods, {Zero} without code pointer, {Distinct} distinct pointers", total, zero, table.Count);
+        return table;
+    }
+
+    private static MethodBase? FromMethodInfo(IntPtr methodInfo)
+    {
+        var klass = IL2CPP.il2cpp_method_get_class(methodInfo);
+        var type = GeneratedType(klass);
+        if (type == null)
+        {
+            Microsoft.Extensions.Logging.LoggerExtensions.LogDebug(Logger.Instance,
+                "arm64 xref resolver: no generated type for {Ns}.{Name} in {Image}", IL2CPP.il2cpp_class_get_namespace_(klass),
+                IL2CPP.il2cpp_class_get_name_(klass), Marshal.PtrToStringUTF8(IL2CPP.il2cpp_image_get_name(IL2CPP.il2cpp_class_get_image(klass))));
+            return null;
+        }
+        const BindingFlags all = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static |
+                                 BindingFlags.Instance | BindingFlags.DeclaredOnly;
+        foreach (var m in type.GetMethods(all).Cast<MethodBase>().Concat(type.GetConstructors(all)))
+        {
+            if (m.IsAbstract) continue;
+            try
+            {
+                var field = Il2CppInteropUtils.GetIl2CppMethodInfoPointerFieldForGeneratedMethod(m);
+                if (field != null && field.GetValue(null) is IntPtr p && p == methodInfo)
+                    return m;
+            }
+            catch (Exception)
+            {
+                // methods without a generated method-info field
+            }
+        }
+
+        Microsoft.Extensions.Logging.LoggerExtensions.LogDebug(Logger.Instance,
+            "arm64 xref resolver: {Type} has no generated method for MethodInfo 0x{Mi}", type.FullName, methodInfo.ToString("X"));
+        return null;
+    }
+
+    private static Type? GeneratedType(IntPtr klass)
+    {
+        var declaring = IL2CPP.il2cpp_class_get_declaring_type(klass);
+        if (declaring != IntPtr.Zero)
+            return GeneratedType(declaring)?.GetNestedType(IL2CPP.il2cpp_class_get_name_(klass)!,
+                BindingFlags.Public | BindingFlags.NonPublic);
+
+        var ns = IL2CPP.il2cpp_class_get_namespace_(klass) ?? "";
+        var name = IL2CPP.il2cpp_class_get_name_(klass)!;
+        var image = Marshal.PtrToStringUTF8(IL2CPP.il2cpp_image_get_name(IL2CPP.il2cpp_class_get_image(klass)))!;
+        var assemblyName = System.IO.Path.GetFileNameWithoutExtension(image);
+        // Interop assemblies only: "mscorlib" is also the name of a .NET facade that forwards System.* types.
+        var interop = AppDomain.CurrentDomain.GetAssemblies()
+            .Where(asm => asm.GetName().Name == "Il2Cpp" + assemblyName ||
+                          (asm.GetName().Name == assemblyName && asm.GetReferencedAssemblies().Any(r => r.Name == "Il2CppInterop.Runtime")))
+            .OrderBy(asm => asm.GetName().Name == assemblyName ? 1 : 0);
+        foreach (var asm in interop)
+        {
+            var t = asm.GetType("Il2Cpp" + (ns.Length == 0 ? "." + name : ns + "." + name), false)
+                    ?? asm.GetType(ns.Length == 0 ? name : ns + "." + name, false);
+            if (t != null && t.Assembly == asm) return t;
+        }
+
+        return null;
+    }
+}
diff --git a/Il2CppInterop.Runtime/XrefScans/XrefScanImpl.cs b/Il2CppInterop.Runtime/XrefScans/XrefScanImpl.cs
index 5015702..cfadd53 100644
--- a/Il2CppInterop.Runtime/XrefScans/XrefScanImpl.cs
+++ b/Il2CppInterop.Runtime/XrefScans/XrefScanImpl.cs
@@ -14,6 +14,17 @@ internal class XrefScanImpl : IXrefScannerImpl
 
     public unsafe (XrefScanUtil.InitMetadataForMethod, IntPtr)? GetMetadataResolver()
     {
+        // arm64: find UnityEngine.Object's static constructor through the il2cpp API (the managed
+        // AppDomain.GetAssemblies route below throws with Unity 6 interop assemblies).
+        if (Arm64Code.IsArm64)
+        {
+            var objectClass = IL2CPP.GetIl2CppClass("UnityEngine.CoreModule.dll", "UnityEngine", "Object");
+            var cctor = objectClass == IntPtr.Zero ? IntPtr.Zero : IL2CPP.il2cpp_class_get_method_from_name(objectClass, ".cctor", 0);
+            if (cctor == IntPtr.Zero) return null;
+            var initPointer = XrefScannerLowLevel.JumpTargets(*(IntPtr*)cctor).First();
+            return (Marshal.GetDelegateForFunctionPointer<XrefScanUtil.InitMetadataForMethod>(initPointer), initPointer);
+        }
+
         getAssemblies ??=
             typeof(AppDomain).GetMethod("GetAssemblies", BindingFlags.Public | BindingFlags.Static)
                     ?.CreateDelegate(typeof(Func<AppDomain, Il2CppReferenceArray<Assembly>>)) as
