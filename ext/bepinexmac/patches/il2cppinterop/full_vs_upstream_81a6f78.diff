diff --git a/Il2CppInterop.Common/XrefScans/Arm64Code.cs b/Il2CppInterop.Common/XrefScans/Arm64Code.cs
new file mode 100644
index 0000000..455030c
--- /dev/null
+++ b/Il2CppInterop.Common/XrefScans/Arm64Code.cs
@@ -0,0 +1,223 @@
+using System;
+using System.Collections.Generic;
+using System.Runtime.InteropServices;
+
+namespace Il2CppInterop.Common.XrefScans;
+
+/// <summary>
+///     Minimal AArch64 code walking for the injector hook lookups on arm64 Mach-O (Apple Silicon).
+///     Function bounds come from the image's LC_FUNCTION_STARTS table, so a "b" is a tail call only when it
+///     lands on another function start; anything else is a branch inside the function.
+/// </summary>
+public static class Arm64Code
+{
+    public static bool IsArm64 => RuntimeInformation.ProcessArchitecture == Architecture.Arm64;
+
+    private static readonly Dictionary<long, long[]> s_StartsByImage = new();
+
+    /// <summary>Same contract as the x86 JumpTargets: BL targets and tail-call targets up to the first RET.</summary>
+    public static IEnumerable<IntPtr> JumpTargets(IntPtr start, bool ignoreRetn)
+    {
+        var starts = StartsFor(start);
+        var stop = NextStart(starts, (long)start);
+        var firstFlowControl = true;
+        for (var at = (long)start; at < stop; at += 4)
+        {
+            var insn = (uint)Marshal.ReadInt32((IntPtr)at);
+            var flow = false;
+            if ((insn & 0xFFFFFC1Fu) == 0xD65F0000u) // RET
+            {
+                if (!ignoreRetn) yield break;
+                flow = true;
+            }
+            else if ((insn & 0xFC000000u) == 0x94000000u) // BL
+            {
+                yield return (IntPtr)BranchTarget(at, insn);
+                flow = true;
+            }
+            else if ((insn & 0xFC000000u) == 0x14000000u) // B
+            {
+                var target = BranchTarget(at, insn);
+                flow = true;
+                if (target != (long)start && IsStart(starts, target))
+                {
+                    yield return (IntPtr)target;
+                    if (firstFlowControl) yield break;
+                }
+            }
+            else if ((insn & 0xFF000010u) == 0x54000000u || (insn & 0x7E000000u) == 0x34000000u ||
+                     (insn & 0x7E000000u) == 0x36000000u || (insn & 0xFFFFFC1Fu) == 0xD61F0000u ||
+                     (insn & 0xFFFFFC1Fu) == 0xD63F0000u)
+            {
+                flow = true; // B.cond, CBZ/CBNZ, TBZ/TBNZ, BR, BLR
+            }
+
+            if (flow) firstFlowControl = false;
+        }
+    }
+
+    /// <summary>Targets of "b" instructions that leave the function (tail calls), in address order.</summary>
+    public static List<IntPtr> TailCallTargets(IntPtr start)
+    {
+        var starts = StartsFor(start);
+        var stop = NextStart(starts, (long)start);
+        var result = new List<IntPtr>();
+        for (var at = (long)start; at < stop; at += 4)
+        {
+            var insn = (uint)Marshal.ReadInt32((IntPtr)at);
+            if ((insn & 0xFC000000u) != 0x14000000u) continue;
+            var target = BranchTarget(at, insn);
+            if (target != (long)start && IsStart(starts, target))
+                result.Add((IntPtr)target);
+        }
+
+        return result;
+    }
+
+    /// <summary>
+    ///     The target of the only BL (up to the first RET) whose second argument (x1) was just set to the address
+    ///     of a stack slot ("add x1, sp|x29, #imm"); 0 if there is none or more than one.
+    /// </summary>
+    public static IntPtr CallWithStackAddressInSecondArgument(IntPtr start)
+    {
+        var stop = NextStart(StartsFor(start), (long)start);
+        long found = 0;
+        var x1IsStackAddress = false;
+        for (var at = (long)start; at < stop; at += 4)
+        {
+            var insn = (uint)Marshal.ReadInt32((IntPtr)at);
+            if ((insn & 0xFFFFFC1Fu) == 0xD65F0000u)
+                break;
+            if ((insn & 0xFC000000u) == 0x94000000u)
+            {
+                if (x1IsStackAddress)
+                {
+                    if (found != 0) return IntPtr.Zero;
+                    found = BranchTarget(at, insn);
+                }
+
+                x1IsStackAddress = false;
+                continue;
+            }
+
+            // ADD (immediate, 64-bit): sf=1 op=0 S=0 100010 sh imm12 Rn Rd
+            if ((insn & 0xFF800000u) == 0x91000000u && (insn & 0x1F) == 1)
+            {
+                var rn = (insn >> 5) & 0x1F;
+                x1IsStackAddress = rn is 31 or 29; // sp or frame pointer
+                continue;
+            }
+
+            // Anything else with x1 in the destination field clears the mark (stores too: conservative).
+            if ((insn & 0x1F) == 1)
+                x1IsStackAddress = false;
+        }
+
+        return (IntPtr)found;
+    }
+
+    private static long BranchTarget(long at, uint insn)
+    {
+        var imm26 = (int)(insn << 6) >> 6;
+        return at + imm26 * 4L;
+    }
+
+    private static bool IsStart(long[] starts, long address) => Array.BinarySearch(starts, address) >= 0;
+
+    private static long NextStart(long[] starts, long address)
+    {
+        var i = Array.BinarySearch(starts, address);
+        i = i >= 0 ? i + 1 : ~i;
+        return i < starts.Length ? starts[i] : address + 0x10000;
+    }
+
+    private static long[] StartsFor(IntPtr address)
+    {
+        if (dladdr(address, out var info) == 0 || info.dli_fbase == IntPtr.Zero)
+            throw new InvalidOperationException($"No loaded image contains 0x{(long)address:X}");
+
+        var header = (long)info.dli_fbase;
+        lock (s_StartsByImage)
+        {
+            if (s_StartsByImage.TryGetValue(header, out var cached))
+                return cached;
+            var starts = ReadFunctionStarts(header);
+            s_StartsByImage[header] = starts;
+            return starts;
+        }
+    }
+
+    private static long[] ReadFunctionStarts(long header)
+    {
+        if ((uint)Marshal.ReadInt32((IntPtr)header) != 0xFEEDFACFu)
+            throw new InvalidOperationException("Not a 64-bit Mach-O image");
+
+        var ncmds = Marshal.ReadInt32((IntPtr)(header + 16));
+        var cmd = header + 32;
+        long textVm = -1, linkVm = -1, linkFileOff = 0;
+        uint startsOff = 0, startsSize = 0;
+        for (var i = 0; i < ncmds; i++)
+        {
+            var kind = (uint)Marshal.ReadInt32((IntPtr)cmd);
+            var size = Marshal.ReadInt32((IntPtr)(cmd + 4));
+            if (kind == 0x19) // LC_SEGMENT_64
+            {
+                var name = Marshal.PtrToStringAnsi((IntPtr)(cmd + 8));
+                var vmaddr = Marshal.ReadInt64((IntPtr)(cmd + 24));
+                var fileoff = Marshal.ReadInt64((IntPtr)(cmd + 40));
+                if (name == "__TEXT") textVm = vmaddr;
+                if (name == "__LINKEDIT")
+                {
+                    linkVm = vmaddr;
+                    linkFileOff = fileoff;
+                }
+            }
+            else if (kind == 0x26) // LC_FUNCTION_STARTS
+            {
+                startsOff = (uint)Marshal.ReadInt32((IntPtr)(cmd + 8));
+                startsSize = (uint)Marshal.ReadInt32((IntPtr)(cmd + 12));
+            }
+
+            cmd += size;
+        }
+
+        if (textVm < 0 || linkVm < 0 || startsSize == 0)
+            throw new InvalidOperationException("Image has no LC_FUNCTION_STARTS");
+
+        var slide = header - textVm;
+        var p = slide + linkVm + (startsOff - linkFileOff);
+        var end = p + startsSize;
+        var result = new List<long>();
+        var address = header; // first delta is from the start of __TEXT
+        while (p < end)
+        {
+            ulong delta = 0;
+            var shift = 0;
+            byte b;
+            do
+            {
+                b = Marshal.ReadByte((IntPtr)p++);
+                delta |= (ulong)(b & 0x7F) << shift;
+                shift += 7;
+            } while ((b & 0x80) != 0);
+
+            if (delta == 0) break;
+            address += (long)delta;
+            result.Add(address);
+        }
+
+        return result.ToArray();
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct DlInfo
+    {
+        public IntPtr dli_fname;
+        public IntPtr dli_fbase;
+        public IntPtr dli_sname;
+        public IntPtr dli_saddr;
+    }
+
+    [DllImport("libSystem.dylib")]
+    private static extern int dladdr(IntPtr addr, out DlInfo info);
+}
