index 0000000..33de1d1
--- /dev/null
+++ b/Il2CppInterop.HarmonySupport/Arm64Abi.cs
@@ -0,0 +1,31 @@
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime;
+using ValueType = Il2CppSystem.ValueType;
+
+namespace Il2CppInterop.HarmonySupport;
+
+/// <summary>AAPCS64 rules the x64-shaped trampolines need on arm64.</summary>
+internal static class Arm64Abi
+{
+    public static bool IsArm64 => RuntimeInformation.ProcessArchitecture == Architecture.Arm64;
+
+    /// <summary>Two general registers; CoreCLR passes and returns this 16-byte non-HFA struct in x(n), x(n+1).</summary>
+    [StructLayout(LayoutKind.Sequential)]
+    public struct Pair
+    {
+        public long Low;
+        public long High;
+    }
+
+    /// <summary>Value size of a non-blittable interop struct that arm64 passes in registers, else 0.</summary>
+    public static int SmallStructSize(Type managedType)
+    {
+        if (!IsArm64 || managedType.IsByRef || !managedType.IsSubclassOf(typeof(ValueType)))
+            return 0;
+        uint align = 0;
+        var size = IL2CPP.il2cpp_class_value_size(Il2CppClassPointerStore.GetNativeClassPointer(managedType), ref align);
+        return size is > 0 and <= 16 ? size : 0;
+    }
+
+    public static Type RegisterType(int size) => size <= 8 ? typeof(long) : typeof(Pair);
+}
diff --git a/Il2CppInterop.HarmonySupport/Arm64ReturnBufferThunk.cs b/Il2CppInterop.HarmonySupport/Arm64ReturnBufferThunk.cs
new file mode 100644
index 0000000..d208f32
--- /dev/null
+++ b/Il2CppInterop.HarmonySupport/Arm64ReturnBufferThunk.cs
@@ -0,0 +1,82 @@
+using System.Reflection;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Common;
+using Microsoft.Extensions.Logging;
+
+namespace Il2CppInterop.HarmonySupport;
+
+/// <summary>
+///     arm64 (AAPCS64): a struct returned through memory has its buffer address in x8, and the arguments start at
+///     x0. The native-to-managed trampoline takes the buffer as its first parameter (the x64 System V / Win64
+///     layout), so this thunk shifts x0..x6 to x1..x7, moves x8 into x0 and jumps to the trampoline.
+/// </summary>
+internal static class Arm64ReturnBufferThunk
+{
+    private const int PROT_READ = 1, PROT_WRITE = 2, PROT_EXEC = 4, MAP_PRIVATE = 2, MAP_ANON = 0x1000;
+
+    public static IntPtr Create(IntPtr trampoline, Type[] unmanagedParams, MethodBase method)
+    {
+        // Every parameter here is passed in a general register (pointer, integer, bool) or a vector register
+        // (float, double). The shift only works while all general-register arguments still fit in x0..x7.
+        var generalCount = 0;
+        foreach (var t in unmanagedParams)
+        {
+            if (t == typeof(float) || t == typeof(double))
+                continue;
+            if (t == typeof(Arm64Abi.Pair))
+            {
+                generalCount += 2;
+                continue;
+            }
+            if (!(t.IsPointer || t.IsPrimitive || t == typeof(IntPtr) || t == typeof(UIntPtr)))
+            {
+                Logger.Instance.LogWarning("arm64: {Method} returns a struct through x8 and takes a by-value {Type}; not patched for arm64",
+                    $"{method.DeclaringType?.FullName}::{method.Name}", t);
+                return IntPtr.Zero;
+            }
+            generalCount++;
+        }
+
+        if (generalCount > 8)
+        {
+            Logger.Instance.LogWarning("arm64: {Method} returns a struct through x8 and has {Count} register arguments (max 8); not patched for arm64",
+                $"{method.DeclaringType?.FullName}::{method.Name}", generalCount);
+            return IntPtr.Zero;
+        }
+
+        var code = new uint[]
+        {
+            0xAA0603E7, // mov x7, x6
+            0xAA0503E6, // mov x6, x5
+            0xAA0403E5, // mov x5, x4
+            0xAA0303E4, // mov x4, x3
+            0xAA0203E3, // mov x3, x2
+            0xAA0103E2, // mov x2, x1
+            0xAA0003E1, // mov x1, x0
+            0xAA0803E0, // mov x0, x8
+            0x58000050, // ldr x16, #8
+            0xD61F0200, // br x16
+        };
+        var size = (nuint)(code.Length * 4 + 8);
+        var page = mmap(IntPtr.Zero, 0x4000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (page == new IntPtr(-1))
+            throw new InvalidOperationException("arm64 return-buffer thunk: mmap failed");
+        for (var i = 0; i < code.Length; i++)
