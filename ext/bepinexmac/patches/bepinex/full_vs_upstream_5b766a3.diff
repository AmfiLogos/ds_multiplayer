     private static nint FollowExportThunks(nint func)
     {
         if (func == 0) return func;
+
+        // arm64 (clang Mach-O): an export can be one 4-byte "b imm26" to the body, packed next to the
+        // other exports. A 16-byte detour written there overwrites the neighbouring exports.
+        if (RuntimeInformation.ProcessArchitecture == Architecture.Arm64)
+        {
+            var at = func;
+            for (var hops = 0; hops < 8; hops++)
+            {
+                uint insn;
+                try { insn = (uint) Marshal.ReadInt32(at); }
+                catch { return at; }
+                if ((insn & 0xFC000000u) != 0x14000000u)
+                    break;
+                at += (nint) (((int) (insn << 6) >> 6) * 4L); // sign-extended imm26 * 4
+            }
+            return at;
+        }
+
+        // These encodings identify export thunks only on x86/x64. Leave pointers on
+        // other architectures unchanged for the selected detour provider.
+        if (RuntimeInformation.ProcessArchitecture is not (Architecture.X86 or Architecture.X64))
+            return func;
+
