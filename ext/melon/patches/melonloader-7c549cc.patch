+    // DS LOCAL PATCH (ds_multiplayer ext/melon, same as our BepInEx fork's FollowExportThunks): on arm64 (clang Mach-O)
+    // a function can be one 4-byte "b imm26" to its body, packed next to other code; a 16-byte detour written there
+    // overwrites the neighbours (Class::FromName on Dungeon Settlers). Hook the body instead; same behaviour for callers.
+    internal static nint FollowArm64Thunks(nint func)
+    {
+#if NET6_0_OR_GREATER
+        if (func == 0 || RuntimeInformation.ProcessArchitecture != Architecture.Arm64)
+            return func;
+#else
+        return func;
+#endif
+        for (int hops = 0; hops < 8; hops++)
+        {
+            uint ins = (uint)Marshal.ReadInt32(func);
+            if ((ins & 0xFC000000u) != 0x14000000u)
+                break;
+            long imm = ins & 0x03FFFFFFL;
+            if ((imm & 0x02000000L) != 0) imm -= 0x04000000L;
+            func = (nint)((long)func + imm * 4);
+        }
+        return func;
+    }
